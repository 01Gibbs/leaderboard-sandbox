#!/usr/bin/env bash
# Lints and runs the fast tests before each commit (docs/MAINTAINING.md says how long). Use it per commit:
#   git -c core.hooksPath=.githooks commit
# Skip it for one commit with --no-verify; Test the grader still runs everything on the pull request.
set -euo pipefail
# Git exports GIT_DIR, GIT_INDEX_FILE and others to hooks (all of them when committing from a worktree). Tests that
# make throwaway repositories would otherwise run git against this one: commit into it, even rewrite its config.
unset $(git rev-parse --local-env-vars)
if command -v uvx >/dev/null; then
  uvx ruff@0.14.0 check grader walkthrough.py
elif command -v pipx >/dev/null; then
  pipx run ruff==0.14.0 check grader walkthrough.py
else
  echo 'pre-commit: install uv or pipx to lint with ruff; skipping lint' >&2
fi
GRADER_FAST=1 python3 -m unittest discover grader/tests
